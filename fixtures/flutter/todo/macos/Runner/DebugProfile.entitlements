<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is OFF for debug/test builds only (this file, not
	     Release.entitlements): integration_test/nostos_live_test.dart (W5)
	     spawns `cargo run -p nostos-cli -- dev` as a subprocess from within
	     the running .app, which the sandbox's process-spawn restriction
	     otherwise blocks with "Operation not permitted" — same rationale as
	     sdk/nostos_flutter/example's DebugProfile.entitlements. A real shipped
	     app has no reason to spawn subprocesses and should keep this
	     sandboxed — see Release.entitlements, left untouched. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
