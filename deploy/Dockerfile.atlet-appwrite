FROM rust:1.98-bookworm AS builder
WORKDIR /nostos
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/nostos/target \
    cargo build --locked --release -p nostos-server && \
    cp target/release/nostos-server /usr/local/bin/nostos-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/bin/nostos-server /usr/local/bin/nostos-server
USER 65532:65532
EXPOSE 8800
CMD ["nostos-server"]
