# Copy to .env (in crates/nostos-cloud/, or wherever you run the binary from)
# and edit. Never commit .env. Vars per crates/nostos-cloud/src/main.rs Config.

# --- server ---
NOSTOS_CLOUD_BIND=0.0.0.0:9090
NOSTOS_LOG=info,nostos_cloud=debug

# --- required ---
# HMAC secret for signing license tokens. No default — the binary refuses to
# start without it.
NOSTOS_LICENSE_SECRET=change-me

# --- storage ---
# SQLite database path. Use ":memory:" for ephemeral dev.
NOSTOS_CLOUD_DB=nostos-cloud.db

# --- Stripe billing (optional; unset = billing endpoints return 503) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe Price ids per tier.
STRIPE_PRICE_PRO=price_replace_me_pro
STRIPE_PRICE_SCALE=price_replace_me_scale
STRIPE_PRICE_ENTERPRISE=price_replace_me_enterprise

# --- public URL (used to build Stripe checkout/redirect URLs) ---
NOSTOS_CLOUD_PUBLIC_URL=http://localhost:9100

# --- Supabase JWT (optional) ---
# When set, `Authorization: Bearer <jwt>` is accepted on authed routes
# alongside the session cookie. When unset, only the session-cookie
# (OSS self-host) path is accepted.
SUPABASE_JWT_SECRET=
