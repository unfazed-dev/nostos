{
  "$description": "Atlet v2 design tokens — W3C DTCG 2025.10. Palette grounded in v1 styles.css :root (preserved).",
  "color": {
    "brand": {
      "0":   { "$type": "color", "$value": "#D2522B", "$extensions": { "com.apple.liquid-glass": { "tint": "#D2522B", "variant": "regular" }, "com.google.material3": { "scheme": "primary" } } },
      "700":{ "$type": "color", "$value": "#B8431F" }
    },
    "bg": {
      "surface":        { "$type": "color", "$value": "#F5F0E8" },
      "surface-2":      { "$type": "color", "$value": "#EAE3D6" },
      "paper":          { "$type": "color", "$value": "#FBF8F2" },
      "status-bar-bg":  { "$type": "color", "$value": "#1A1714" }
    },
    "fg": {
      "ink":   { "$type": "color", "$value": "#1A1714" },
      "muted": { "$type": "color", "$value": "#6E6760" },
      "faint": { "$type": "color", "$value": "#A39A8E" }
    },
    "border": { "rule": { "$type": "color", "$value": "#D8CFBE" } },
    "status": {
      "good":   { "$type": "color", "$value": "#4A7C3A" },
      "warn":   { "$type": "color", "$value": "#C68D2E" },
      "danger": { "$type": "color", "$value": "#FF3B30" }
    }
  },
  "radius": {
    "sm":  { "$type": "dimension", "$value": "10px" },
    "md":  { "$type": "dimension", "$value": "16px" },
    "lg":  { "$type": "dimension", "$value": "24px" }
  },
  "typography": {
    "sans": { "$type": "fontFamily", "$value": "Lexend" },
    "mono": { "$type": "fontFamily", "$value": "JetBrains Mono" }
  },
  "motion": {
    "rise": {
      "duration": { "$type": "duration", "$value": "0.55s" },
      "curve":    { "$type": "cubicBezier", "$value": [0.2, 0.85, 0.2, 1] },
      "dy":       { "$type": "dimension", "$value": "14px" }
    }
  },
  "$extensions": {
    "com.fluttercrew.aliases": {
      "_description": "Maps the closed generator token vocabulary (the canonical names the builder emits — ink/bone/accent/...) → THIS design's semantic DTCG tokens. The builder resolves every hex via this block (transform_tokens._emit_aliases emits AppTokens.<name> from it); it carries ZERO design-specific hex literals. Design-agnostic by contract (ADR: design-format generalization). Keyed by the legacy name; value is a $ref (preferred — points at a real semantic token) or a literal $value hex (for a name with no semantic equivalent in this design).",
      "ink":        { "$ref": "color.fg.ink" },
      "ink2":       { "$value": "#3A3530" },
      "ink3":       { "$ref": "color.fg.muted" },
      "ink4":       { "$ref": "color.fg.faint" },
      "bone":       { "$ref": "color.bg.surface" },
      "bone3":      { "$ref": "color.bg.surface-2" },
      "paper":      { "$ref": "color.bg.paper" },
      "accent":     { "$ref": "color.brand.0" },
      "accent2":    { "$ref": "color.brand.700" },
      "accentSoft": { "$value": "#E8C9BC" },
      "rule":       { "$ref": "color.border.rule" }
    }
  }
}
