# Local-profile services for the Atlet nostos-vs-PowerSync comparison (Task 5).
# Copy to `.env` and fill in real values — never commit `.env`.
#
# Supabase Postgres is IPv6-only (db.PROJECT_REF.supabase.co has no A record).
# If your network can't route IPv6 directly, run scripts/warp-ipv6-egress.sh
# (repo root) and point *_PG_URL at 127.0.0.1:15433 with sslmode=disable
# instead of the db.PROJECT_REF.supabase.co host with sslmode=require.

# nostos-server's own replication connection (any role with REPLICATION + read
# access to the tables it fans out; ADR-0025 assumes REPLICA IDENTITY FULL on
# tables nostos deletes-and-replays — see task-5-report.md T5-C1).
ATLET_PG_URL=postgres://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# powersync_role's connection (provisioned by
# apps/atlet/supabase/migrations/0002_powersync_replication.sql; password set
# by apps/atlet/supabase/scripts/provision_powersync_role.sh — operator-owned).
POWERSYNC_PG_URL=postgres://powersync_role:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Used by nostos-server (Supabase-JWT auth, JWKS derived from this URL) and
# available to PowerSync if you switch it to JWKS-based verification instead
# of the shared-secret path below.
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Legacy Supabase JWT signing secret. Verifies tokens for both engines:
# nostos-server (NOSTOS_SUPABASE_JWT_SECRET, fallback alongside SUPABASE_URL)
# and PowerSync (client_auth.supabase_jwt_secret in powersync/config.yaml).
SUPABASE_JWT_SECRET=...

# cairn's write-back allowlist (ADR-0013) — Atlet only allows client writes
# to `sessions`; `products` stays read-only server data.
NOSTOS_WRITE_TABLES=sessions
