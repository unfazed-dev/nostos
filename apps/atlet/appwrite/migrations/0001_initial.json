        { "key": "metric", "type": "integer", "required": true },
        { "key": "unit", "type": "varchar", "size": 32, "required": true },
        { "key": "note", "type": "text", "required": false },
        { "key": "streak", "type": "integer", "required": true },
        { "key": "occurred_on", "type": "datetime", "required": true },
        { "key": "server_committed_at", "type": "datetime", "required": false }
      ],
      "indexes": [{ "key": "session_user_date", "type": "key", "attributes": ["user_id", "occurred_on"] }]
    },
    {
      "table_id": "products", "name": "Products", "row_security": true,
      "columns": [
        { "key": "name", "type": "varchar", "size": 256, "required": true },
        { "key": "category", "type": "varchar", "size": 128, "required": true },
        { "key": "price_cents", "type": "integer", "required": true },
        { "key": "rating", "type": "double", "required": false },
        { "key": "plant_based", "type": "boolean", "required": true },
        { "key": "image_url", "type": "url", "required": false },
        { "key": "image_id", "type": "varchar", "size": 36, "required": false }
      ]
    },
    {
      "table_id": "cart_items", "name": "Cart items", "row_security": true,
      "columns": [
        { "key": "user_id", "type": "varchar", "size": 36, "required": true },
        { "key": "product_id", "type": "varchar", "size": 36, "required": true },
        { "key": "qty", "type": "integer", "required": true },
        { "key": "added_at", "type": "datetime", "required": true }
      ],
      "indexes": [{ "key": "cart_user", "type": "key", "attributes": ["user_id"] }]
    },
    {
      "table_id": "orders", "name": "Orders", "row_security": true,
      "columns": [
        { "key": "user_id", "type": "varchar", "size": 36, "required": true },
        { "key": "status", "type": "varchar", "size": 24, "required": true },
        { "key": "subtotal_cents", "type": "integer", "required": true },
        { "key": "tax_cents", "type": "integer", "required": true },
        { "key": "shipping_cents", "type": "integer", "required": true },
        { "key": "total_cents", "type": "integer", "required": true },
        { "key": "payment_ref", "type": "varchar", "size": 128, "required": false },
        { "key": "items_json", "type": "longtext", "required": false },
        { "key": "created_at", "type": "datetime", "required": true }
