      "indexes": [{ "key": "orders_user_date", "type": "key", "attributes": ["user_id", "created_at"] }]
    },
    {
      "table_id": "order_events", "name": "Order events", "row_security": true,
      "columns": [
        { "key": "user_id", "type": "varchar", "size": 36, "required": true },
