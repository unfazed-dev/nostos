      "indexes": [{ "key": "profile_user", "type": "unique", "attributes": ["user_id"] }]
    }
  ],
  "bootstrap_rows": [
    { "table_id": "sync_clock", "row_id": "clock", "data": { "head": 0 } }
  ]
}
