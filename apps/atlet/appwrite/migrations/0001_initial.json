{
  "version": 1,
  "database": { "database_id": "atlet", "name": "Atlet" },
  "team": { "team_id": "atlet_admins", "name": "Atlet admins" },
  "tables": [
    {
      "table_id": "schema_migrations", "name": "Schema migrations", "row_security": false,
      "columns": [
        { "key": "version", "type": "integer", "required": true },
        { "key": "checksum", "type": "varchar", "size": 64, "required": true },
        { "key": "applied_at", "type": "datetime", "required": true }
      ]
    },
    {
      "table_id": "sync_clock", "name": "Sync clock", "row_security": false,
      "columns": [
        { "key": "head", "type": "bigint", "required": true }
      ]
    },
    {
      "table_id": "sync_changes", "name": "Sync changes", "row_security": false,
      "columns": [
        { "key": "seq", "type": "bigint", "required": true },
        { "key": "table_name", "type": "varchar", "size": 64, "required": true },
        { "key": "pk", "type": "varchar", "size": 36, "required": true },
        { "key": "op", "type": "varchar", "size": 12, "required": true },
        { "key": "row_json", "type": "longtext", "required": false },
        { "key": "owner_id", "type": "varchar", "size": 36, "required": false },
        { "key": "audience", "type": "varchar", "size": 16, "required": true }
      ],
      "indexes": [
        { "key": "seq_unique", "type": "unique", "attributes": ["seq"] },
        { "key": "owner_seq", "type": "key", "attributes": ["owner_id", "seq"] }
      ]
    },
    {
      "table_id": "sessions", "name": "Training sessions", "row_security": true,
      "columns": [
        { "key": "user_id", "type": "varchar", "size": 36, "required": true },
        { "key": "title", "type": "varchar", "size": 256, "required": true },
