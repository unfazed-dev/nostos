        { "key": "status", "type": "varchar", "size": 24, "required": true },
        { "key": "previous_status", "type": "varchar", "size": 24, "required": false },
        { "key": "note", "type": "text", "required": false },
        { "key": "created_at", "type": "datetime", "required": true }
      ],
      "indexes": [{ "key": "events_order_date", "type": "key", "attributes": ["order_id", "created_at"] }]
    },
    {
      "table_id": "attachments", "name": "Product image metadata", "row_security": true,
      "columns": [
        { "key": "filename", "type": "varchar", "size": 256, "required": true },
        { "key": "size", "type": "bigint", "required": true },
        { "key": "media_type", "type": "varchar", "size": 128, "required": true },
        { "key": "state", "type": "varchar", "size": 24, "required": true },
        { "key": "timestamp", "type": "bigint", "required": true }
      ]
    },
    {
      "table_id": "user_profiles", "name": "User profiles", "row_security": true,
      "columns": [
        { "key": "user_id", "type": "varchar", "size": 36, "required": true },
        { "key": "display_name", "type": "varchar", "size": 128, "required": true },
        { "key": "active", "type": "boolean", "required": true }
