# Copy to apps/atlet/.env.cloud and chmod 600. Never commit the filled file.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6ab741900038c74d1086
# Set after deploying the always-on nostos-server gateway (server mode only).
NOSTOS_APPWRITE_GATEWAY_URL=https://nostos-atlet-appwrite.example.com
ATLET_ADMIN_EMAIL=admin@example.com
ATLET_ADMIN_PASSWORD=replace-me
ATLET_USER_A_EMAIL=customer-a@example.com
ATLET_USER_A_PASSWORD=replace-me
ATLET_USER_B_EMAIL=customer-b@example.com
ATLET_USER_B_PASSWORD=replace-me
