# Build artifacts
/target/

# UniFFI-generated Kotlin sources (regenerated from the .so on build;
# not hand-edited, so not checked in — mirrors how nostos_swift does not
# check in the generated .swift).
/kotlin-sources/

# Gradle wrapper working dirs + build output (Android library)
/android/.gradle/
/android/build/
/android/local.properties
/android/app/build/
/android/.cxx/

# Built .aar (release artifact; rebuilt from the .so + sources on demand)
*.aar

# Cross-compiled Rust `.so` copied into jniLibs by the build — a binary cargo
# output (3.3MB), regenerated by `cargo build --target aarch64-linux-android
# --release` then copied into jniLibs/arm64-v8a/. Not committed.
/android/src/main/jniLibs/

# Android test results
/android/**/*.apk
/android/**/outputs/

# macOS noise
.DS_Store
