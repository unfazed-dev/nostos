{
  "name": "@nostos-sync/react-native",
  "version": "0.1.0",
  "description": "React Native facade over nostos-swift / nostos-kotlin UniFFI bindings \u2014 Codegen TurboModule + TS facade. Hermes has no WebAssembly (issue #429), so @nostos-sync/web is a dead end in RN; this is the non-WASM RN path.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && jest"
  },
  "peerDependencies": {
    "react-native": ">=0.79"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "react-native": "^0.79.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostos-sync/nostos.git",
    "directory": "sdk/nostos_react_native"
  },
  "homepage": "https://github.com/nostos-sync/nostos",
  "bugs": {
    "url": "https://github.com/nostos-sync/nostos/issues"
  }
}
