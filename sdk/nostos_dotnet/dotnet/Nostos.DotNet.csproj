<Project Sdk="Microsoft.NET.Sdk">

  <!--
  =============================================================================
  Nostos.DotNet — .NET projection over the Nord UniFFI-CS generated surface.
  =============================================================================
  NOTE: this multi-target project is NOT the one the E2E builds — that is
  dotnet/smoke/Smoke.csproj (net8.0, host-only), which is why the live
  dotnet slice can pass while THIS file has never been compiled. That gap
  hid two hard errors until 2026-07-30: a mismatched PackageProjectUrl
  closing tag, and a double hyphen inside an XML comment (both fatal to any
  `dotnet build`/`pack` of this project). Superseded claim, kept as the
  lesson: this header used to assert "dotnet is not installed on this host,
  E2E is SKIP-with-reason" — `dotnet` IS installed (~/.dotnet/dotnet) and the
  slice PASSES. A stale environment claim in a comment is how the two errors
  above stayed invisible. Building this project needs the iOS/Android/Windows
  workloads, so `make sdk-e2e` deliberately does not.

  Multi-targeting:
    - net8.0-ios          (iOS device + sim — links libnostos_dotnet.dylib via
                           __Internal / DllImport for the .NET iOS workload)
    - net8.0-android      (Android — loads libnostos_dotnet.so via JNI/DllImport
                           for the .NET Android workload)
    - net8.0-windows      (Windows — loads libnostos_dotnet.dll via DllImport)
    - net8.0-maccatalyst  (macOS Catalyst — loads libnostos_dotnet.dylib)

  AllowUnsafeBlocks:
    The Nord uniffi-bindgen-cs emits P/Invoke pointers (IntPtr,
    unsafe-pointer casts, Marshal.AllocHGlobal). C# requires `unsafe` blocks
    to touch those. This is a C#-project property ONLY — the Rust crate at
    ../src/lib.rs keeps #![forbid(unsafe_code)]; the bindgen-generated C# is
    the ADR-0015 addendum machine-generated exception on the .NET side.
  =============================================================================
  -->

  <PropertyGroup>
    <!-- Multi-target iOS / Android / Windows / macOS Catalyst. net8.0 is the
         floor; bump to net9.0/net10.0 when the CI image supports it. -->
    <TargetFrameworks>net8.0-ios;net8.0-android;net8.0-windows;net8.0-maccatalyst</TargetFrameworks>
    <RootNamespace>Nostos</RootNamespace>
    <AssemblyName>Nostos.DotNet</AssemblyName>
    <PackageId>Nostos.DotNet</PackageId>
    <Version>0.2.0</Version>
    <Description>UniFFI bridge exposing nostos-client's SyncClient&lt;SqliteStorage&gt; to .NET via Nord UniFFI-CS — feasibility scaffold.</Description>
    <Authors>unfazed-dev</Authors>
    <Company>unfazed-dev</Company>
    <Copyright>Apache-2.0</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/unfazed-dev/nostos</PackageProjectUrl>
    <RepositoryUrl>https://github.com/unfazed-dev/nostos</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- C# side needs unsafe for the bindgen's IntPtr / P/Invoke glue.
         Rust side stays forbid(unsafe_code) — see ../src/lib.rs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Generate a NuGet .nupkg on pack (the next increment past this
         scaffold; not wired today — see ../README.md). -->
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- The committed bindgen output. The Nord uniffi-bindgen-cs names the
         file after the namespace (nostos.cs), NOT after the primary class.
         Regenerate with the `uniffi-bindgen-cs` invocation in ../README.md
         ("Regenerate the C# bindings"). The exact flags are NOT inlined here:
         an XML comment may not contain a double hyphen, so pasting a CLI
         flag into this file makes the whole .csproj unparseable. -->
    <Compile Include="generated/**/*.cs" Exclude="bin/**;obj/**" />
  </ItemGroup>

  <!--
  Native library packaging — the cross-compiled cdylibs land under
  runtimes/<RID>/native/ in the .nupkg so the .NET loader picks them up
  automatically. The actual copy step is the next increment (a build target
  that ships libnostos_dotnet.{dylib,so,dll} into the right runtimes/ paths).
  ponytail: not wired today; the .csproj compiles the C# surface standalone
  for the typecheck gate, the native binaries are packaged separately.
  -->
  <ItemGroup Condition="'$(OS)' == 'Unix'">
    <!-- Placeholder: when the native-packaging target lands, these will be
         <None Include="..\target\aarch64-apple-ios\release\libnostos_dotnet.a"
               Pack="true" PackagePath="runtimes/ios/native/" />
         etc. — one per (TFM, RID). -->
  </ItemGroup>

</Project>
