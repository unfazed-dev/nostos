{
  "name": "@nostos-sync/capacitor",
  "version": "0.2.0",
  "description": "Capacitor v8 plugin: in-webview wasm sync (@nostos-sync/web live path) + beta native push bridge (APNs registration token + foreground events on iOS; FCM stays app-side). Push surface is beta (ADR-0037).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prebuild": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\"",
    "test:unit": "node --test test/push_rest.spec.cjs",
    "test:e2e": "cd example-app && npx playwright test --config=playwright.config.cjs",
    "test": "npm run build && npm run test:unit && npm run test:e2e"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "ios",
    "android",
    "Package.swift",
    "NostosCapacitor.podspec",
    "README.md"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "dependencies": {
    "@nostos-sync/web": "file:../nostos_web",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.4.1",
    "@playwright/test": "^1.40.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unfazed-dev/nostos.git",
    "directory": "sdk/nostos_capacitor"
  },
  "homepage": "https://github.com/unfazed-dev/nostos",
  "bugs": {
    "url": "https://github.com/unfazed-dev/nostos/issues"
  }
}
