# Copy to .env and edit. Never commit .env.
# --- server ---
NOSTOS_BIND=0.0.0.0:8800
NOSTOS_LOG=info,nostos=debug
NOSTOS_METRICS_BIND=0.0.0.0:9100
NOSTOS_WS_PATH=/sync

# --- router / backpressure ---
# Per-client bounded channel depth. Slow clients that fall this far behind are
# dropped (an explicit, observable choice — never silent OOM).
NOSTOS_SESSION_BUFFER=1024

# --- postgres (used by the real PgReplicator in Week 2; not needed for Week-1 synth bench) ---
NOSTOS_PG_URL=postgresql://nostos:nostos@localhost:5433/nostos
NOSTOS_PG_SLOT=nostos_slot
NOSTOS_PG_PUBLICATION=nostos_pub

# --- replicator mode ---
# "fake"   = synthetic WAL generator (Week-1 default; no PG needed)
# "pg"     = real Postgres logical replication
NOSTOS_REPLICATOR=fake

# --- write-back (ADR-0013) ---
# Comma-separated list of tables clients may write to over the /sync socket
# (upsert/delete). Exact-match allowlist — a table not listed here can never
# reach the SQL builder. Empty = no tables writable. Only meaningful under
# NOSTOS_REPLICATOR=pg (the fake replicator has no source DB, so writes return
# "write-back requires pg replicator" even when allowlisted). Example: tasks
NOSTOS_WRITE_TABLES=

# --- /sync authentication (ADR-0010 + JWKS addendum) ---
# "none"         = anonymous (OSS self-host dev; single-tenant ONLY; logs a warning)
# "supabase-jwt" = verify a Supabase JWT (multi-tenant). Requires at least one
#                  of NOSTOS_SUPABASE_JWT_SECRET or NOSTOS_SUPABASE_URL /
#                  NOSTOS_SUPABASE_JWKS_URL below.
NOSTOS_SYNC_AUTH=none
# Legacy HS256 shared secret (Supabase projects created before 2025-10-01, or
# that haven't migrated off it). Matches Supabase's JWT_SECRET.
NOSTOS_SUPABASE_JWT_SECRET=
# Supabase project URL, e.g. https://xyzco.supabase.co — used to derive the
# JWKS URL for RS256/ES256/EdDSA verification (Supabase's default for
# projects created since 2025-10-01). Superseded by NOSTOS_SUPABASE_JWKS_URL.
NOSTOS_SUPABASE_URL=
# Explicit JWKS URL, overriding the one derived from NOSTOS_SUPABASE_URL. Only
# needed behind a non-standard gateway/proxy.
NOSTOS_SUPABASE_JWKS_URL=
# Cloud direct-Postgres for nostos-server's PgReplicator (NOSTOS_REPLICATOR=pg).
# Logical replication needs the DIRECT connection (db.<ref>.supabase.co:5432),
# NOT the pooler. Apply docker/pg-init/01-sources.sql (tasks + nostos_pub) first.
# NOTE: db.<ref>.supabase.co is IPv6-only on Supabase — reachable only with host
# IPv6 or the Supabase IPv4 add-on (see docs/plans/nostos-reference-demo-app.md).
NOSTOS_PG_URL_CLOUD=
# The tenant column server-enforced on every predicate (ADR-0011). When auth is
# supabase-jwt, the server ANDs <column>=<principal.tenant_id> into every
# subscription so a client cannot read another tenant's rows.
NOSTOS_TENANT_COLUMN=org_id

# --- licensing tier (concurrent-device cap) ---
# OSS self-host defaults to "enterprise" (unlimited). A managed Cloud deploy
# stamps the licensed tier here. One of: hobby, pro, scale, enterprise.
NOSTOS_TIER=enterprise

# --- CORS (browser clients) ---
# Comma-separated allowed origins. Empty = permissive (local dev). Set
# explicitly for production, e.g. https://app.example.com
NOSTOS_CORS_ORIGINS=

# --- WAL-bloat protection (ADR-0016) ---
# A client that lags further than this LSN-gap (WAL bytes) behind the head of
# the stream is disconnected; it reconnects + re-syncs from a fresh checkpoint.
# 0 = eviction OFF (default — no client is ever dropped for lag). A production
# deploy MUST set this (or the slot keep-size below) to protect the primary's disk.
NOSTOS_SLOT_MAX_LAG=0

# Postgres max_slot_wal_keep_size for the replication slot (MB). Caps WAL a
# lagging slot retains before Postgres invalidates it — the database backstop.
# 0 = Postgres default (unbounded). Set alongside SLOT_MAX_LAG in production.
NOSTOS_PG_SLOT_WAL_KEEP_SIZE=0
